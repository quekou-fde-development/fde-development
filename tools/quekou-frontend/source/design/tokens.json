  "styles": [
    {
      "id": 1,
      "key": "precision",
      "name": "Precision Swiss",
      "label": "精密秩序",
      "references": "Linear / Vercel",
      "dna": "用精确的网格和细描边，让信息自己建立秩序。",
      "mode": "light",
      "draft": [
        "灰阶铺底，冷蓝仅强调关键数据与操作。",
        "小级差无衬线，以字重区分层级。",
        "1px 描边替代阴影，统一 6px 圆角。",
        "8pt 主布局网格，紧凑且对齐。",
        "细线、编号与克制的冷色。"
      ]
    },
    {
      "id": 2,
      "key": "industrial",
      "name": "Industrial Control Room",
      "label": "工业控制室",
      "references": "Tractian / Palantir",
      "dna": "像控制室一样，把异常留在最醒目的位置。",
      "mode": "dark",
      "draft": [
        "近黑底色；青、琥珀、红只承载状态。",
        "清晰无衬线正文，所有数据使用等宽数字。",
        "内发光与细描边，不使用外部投影。",
        "紧凑监控密度，信息边界清楚。",
        "状态信号、刻度与设备面板感。"
      ]
    },
    {
      "id": 3,
      "key": "editorial",
      "name": "Editorial Density",
      "label": "编辑式密度",
      "references": "Stripe / Attio",
      "dna": "以编辑式标题与清晰分区，组织高密度数据。",
      "mode": "light",
      "draft": [
        "浅深双版，非数据区域保持中性。",
        "衬线标题对比无衬线表格。",
        "细分隔线、轻圆角，无投影。",
        "紧凑表格搭配呼吸感标题区。",
        "大标题、章节编号与数据蓝。"
      ]
    },
    {
      "id": 4,
      "key": "soft",
      "name": "Soft Structured",
      "label": "柔性结构",
      "references": "Rippling / HiBob",
      "dna": "柔软的卡片边界，也能承载严谨的业务结构。",
      "mode": "light",
      "draft": [
        "柔和中性色，饱和紫强调。",
        "亲和的无衬线，数字字重清晰。",
        "16px 圆角与极轻投影。",
        "适中密度，卡片分区。",
        "柔软容器与饱和操作入口。"
      ]
    },
    {
      "id": 5,
      "key": "grid",
      "name": "Data Grid First",
      "label": "表格优先",
      "references": "Clay / Folk",
      "dna": "把表格放在中心，让每一列都成为工作入口。",
      "mode": "light",
      "draft": [
        "中性表格，极小分类色点附文字。",
        "紧凑字号，数值统一右对齐。",
        "网格线定义列，几乎无圆角。",
        "表格置前，列头支持排序，进度可试改。",
        "单元格交互与列头功能入口。"
      ]
    },
    {
      "id": 6,
      "key": "bento",
      "name": "Bento Modular",
      "label": "模块拼图",
      "references": "Apple / Vercel / monday",
      "dna": "大指标与趋势并置，小模块组成经营总览。",
      "mode": "light",
      "draft": [
        "缺口深墨与冷白叠层，工艺蓝承载行动和数据。",
        "64px 主指标与 36px 次指标，主次一眼可分。",
        "标准 20px 圆角与轻微层次阴影，支持安全倍率调整。",
        "大指标＋宽趋势图，下接三个小指标与待办模块。",
        "不等大的模块拼图，深墨主指标形成视觉重心。"
      ]
    },
    {
      "id": 7,
      "key": "glass",
      "name": "Glass Layered",
      "label": "玻璃叠层",
      "references": "Raycast / Arc",
      "dna": "以玻璃层次营造空间，用稳定底色守住可读性。",
      "mode": "dark",
      "draft": [
        "浅色冷白、深色深墨铺底，缺口蓝营造受约束的环境光。",
        "清晰无衬线，高对比正文。",
        "半透明面板、背景模糊、细亮边。",
        "适中密度，层与层保留间隔。",
        "缺口蓝光晕与多层玻璃，现场橙仅用于风险提示。"
      ]
    },
    {
      "id": 8,
      "key": "terminal",
      "name": "Mono Terminal",
      "label": "终端秩序",
      "references": "Bloomberg / Grafana",
      "dna": "剥离装饰，让字符、数字和信号成为界面。",
      "mode": "dark",
      "draft": [
        "近黑底，克制琥珀数据强调。",
        "全等宽字体栈，中文使用本机后备。",
        "直角与细分隔线，无阴影。",
        "紧凑字符网格，强调列对齐。",
        "终端字符、坐标刻度与实线数据。"
      ]
    },
    {
      "id": 9,
      "key": "calm",
      "name": "Scandinavian Calm",
      "label": "北欧留白",
      "references": "Personio / Oura",
      "dna": "暖灰与自然色，让长时间工作也保持平静。",
      "mode": "light",
      "draft": [
        "极浅暖灰底，低饱和森林绿。",
        "自然舒展的无衬线。",
        "14px 圆角，轻描边，无投影。",
        "宽松留白，清晰的阅读节奏。",
        "自然色调与开阔间距。"
      ]
    },
    {
      "id": 10,
      "key": "ambient",
      "name": "AI-Native Ambient",
      "label": "智能环境",
      "references": "Attio / Day.ai",
      "dna": "指标轻量呈现，AI 建议紧贴项目操作区。",
      "mode": "light",
      "draft": [
        "冷白、纯白与工业深墨铺底，缺口蓝系标记 AI 来源。",
        "26px 概览数字，摘要以清晰的正文呈现。",
        "移除指标卡片外框，AI 摘要保留蓝色渐变细边界。",
        "指标条 → AI 摘要与项目表 → 趋势和待办。",
        "嵌在项目工作区的 AI 建议，直接筛选风险项目并保留人工确认。"
      ]
    }
  ],
