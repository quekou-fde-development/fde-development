      {
       "id": "j1.cardinality",
       "family": "cardinality",
       "tier": 1,
       "predicate": {
        "collection": "joined",
        "key_field": "id",
        "expect": "one_to_one"
       },
       "derived_fields": [],
       "source_anchor": "fixtures/jh_rules.md §交接与合并规则",
       "mutants": [
