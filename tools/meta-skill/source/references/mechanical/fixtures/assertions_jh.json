       },
       "derived_fields": [],
       "source_anchor": "fixtures/jh_rules.md §交接与合并规则",
       "mutants": [
        "H3-receipt-missing"
       ]
      }
     ]
    }
   ]
  },
  {
   "stage": "r0_fee_table",
