        "input": {
         "stage": "h0_intake",
         "artifact": "h0_intake.json",
         "collection": "rows",
         "id_field": "id"
        },
        "right": {
         "stage": "r0_fee_table",
         "artifact": "r0_fee_table.json",
         "collection": "rows",
         "key_field": "sku"
        },
        "join_key": "sku"
       },
       "derived_fields": [],
       "source_anchor": "fixtures/jh_rules.md §交接与合并规则",
       "mutants": [
        "J3-unmatched-unlogged",
        "J5-false-unmatched"
       ]
      },
      {
       "id": "j1.joined_value_replay",
       "family": "joined_value_replay",
       "tier": 1,
       "predicate": {
        "collection": "joined",
        "key_field": "id",
        "join_key": "sku",
        "right": {
         "stage": "r0_fee_table",
         "artifact": "r0_fee_table.json",
         "collection": "rows",
         "key_field": "sku"
        },
        "value_fields": {
