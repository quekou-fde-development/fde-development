      },
      {
       "id": "r0.schema_conformance",
       "family": "schema_conformance",
       "tier": 1,
       "predicate": {
        "collection": "rows",
        "required_fields": [
         "sku",
         "fee"
        ],
        "field_types": {
         "sku": "str",
         "fee": "number"
