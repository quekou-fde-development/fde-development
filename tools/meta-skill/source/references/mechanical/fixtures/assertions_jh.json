        "output": {
         "collection": "joined",
         "id_field": "id"
        },
        "unmatched_ids": "unmatched_ids"
       },
       "derived_fields": [],
       "source_anchor": "fixtures/jh_rules.md §交接与合并规则",
       "mutants": [
