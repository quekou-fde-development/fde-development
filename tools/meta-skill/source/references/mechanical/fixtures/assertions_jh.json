       "mutants": [
        "H1-payload-hash-drift"
       ]
      },
      {
       "id": "h0.schema_conformance",
       "family": "schema_conformance",
       "tier": 1,
       "predicate": {
        "collection": "rows",
        "required_fields": [
         "id",
         "sku"
        ],
        "field_types": {
         "id": "str",
         "sku": "str"
        }
       },
       "derived_fields": [],
