      {
       "id": "r0.count_hash",
       "family": "count_hash",
       "tier": 1,
       "predicate": {
        "collection": "rows",
        "declared_count": "row_count",
        "declared_hash": "rows_sha256"
       },
       "derived_fields": [],
       "source_anchor": "fixtures/jh_rules.md §交接与合并规则",
       "mutants": [
        "R3-fee-content-drift"
       ]
      }
     ]
    }
   ]
  },
  {
   "stage": "j1_joined",
   "operations": [
    {
     "op": "join",
     "artifact": "j1_joined.json",
     "source_reachability": "machine",
     "assertions": [
      {
       "id": "j1.key_coverage",
       "family": "key_coverage",
       "tier": 1,
       "predicate": {
        "input": {
         "stage": "h0_intake",
